generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id           Int           @id @default(autoincrement())
  nome         String
  email        String        @unique
  cpf          String        @unique
  telefone     String
  nascimento   DateTime
  endereco     String
  cidade       String
  cep          String
  senha        String
  role         Role          @default(ATLETA)
  funcao       FuncaoFuncionario?
  ativo        Boolean       @default(true)
  fotoPerfil   String?
  criadoEm     DateTime      @default(now())
  atualizadoEm DateTime      @updatedAt

  matriculas               Matricula[]
  matriculasResponsavel    Matricula[]          @relation("MatriculaResponsavel")
  premiacoes               Premiacao[]          @relation("PremiacaoAtleta")
  checkIns                 CheckIn[]
  anamnese                 Anamnese?
  recordes                 Recorde[]
  fotosProgresso           FotoProgresso[]
  biometria                Biometria?
  prontuarioDocs           ProntuarioDoc[]
  treinosPrescritos        TreinoPrescrito[]
  wodsAutor                WOD[]
  funcionario              Funcionario?
  ingressos                Ingresso[]
  pontosSocio              PontoSocio[]
  turmaTreinador           Turma[]              @relation("TurmaTreinador")
  turmasAtleta             TurmaAtleta[]
  modalidadesTreinador     TreinadorModalidade[] @relation("TreinadorModalidades")
  notificacoesDestinadas   Notificacao[]        @relation("NotificacaoDestinatario")
  notificacoesLidas        NotificacaoLida[]
  escalacoesComoTreinador  Escalacao[]          @relation("EscalacaoTreinador")
  escalacoes               EscalacaoAtleta[]    @relation("EscalacaoAtletas")
  videosAutor              VideoTreino[]        @relation("VideosAutor")
  templatesTreino          TemplateTreino[]     @relation("TemplatesTreino")
  tokensRecuperacao        TokenRecuperacaoSenha[]
  prescricoesDieta         PrescricaoDieta[]    @relation("PrescricaoDietaAtleta")
  prescricoesDietaAutor    PrescricaoDieta[]    @relation("PrescricaoDietaAutor")
}

model Modalidade {
  id        Int         @id @default(autoincrement())
  nome      String
  descricao String      @db.Text
  categoria String
  ativa     Boolean     @default(true)

  matriculas  Matricula[]
  treinadores TreinadorModalidade[]
}

model Plano {
  id        Int             @id @default(autoincrement())
  nome      String
  valor     Decimal         @db.Decimal(10, 2)
  descricao String?
  ativo     Boolean         @default(true)
  categoria CategoriaPlano  @default(TURMA_REGULAR)

  matriculas Matricula[]
}

model Matricula {
  id             Int             @id @default(autoincrement())
  usuarioId      Int
  modalidadeId   Int
  planoId        Int
  responsavelId  Int?
  status         StatusMatricula @default(ATIVA)
  dataPagamento  DateTime?
  criadoEm       DateTime        @default(now())

  usuario    Usuario    @relation(fields: [usuarioId], references: [id])
  modalidade Modalidade @relation(fields: [modalidadeId], references: [id])
  plano      Plano      @relation(fields: [planoId], references: [id])
  responsavel Usuario?  @relation("MatriculaResponsavel", fields: [responsavelId], references: [id])
}

model ProjetoSocial {
  id        Int      @id @default(autoincrement())
  titulo    String
  slug      String   @unique
  subtitulo String?
  descricao String   @db.Text
  conteudo  String?  @db.Text
  imagemUrl String?
  icone     String   @default("heart")
  ativo     Boolean  @default(true)
  criadoEm  DateTime @default(now())
}

model DocumentoOficial {
  id        Int      @id @default(autoincrement())
  titulo    String
  descricao String?
  fileUrl   String
  ativo     Boolean  @default(true)
  criadoEm  DateTime @default(now())
}

model Lead {
  id        Int      @id @default(autoincrement())
  nome      String
  email     String
  whatsapp  String?
  origem    String   @default("eventos")
  criadoEm  DateTime @default(now())
}

enum Role {
  ATLETA
  TREINADOR
  ADMIN
  SOCIO_TORCEDOR
}

enum StatusMatricula {
  ATIVA
  INATIVA
  PENDENTE
}

enum StatusTurma {
  PROPOSTA
  PENDENTE_APROVACAO
  ATIVA
  INATIVA
}

enum FuncaoFuncionario {
  PROFESSOR
  NUTRICIONISTA
  FISIOTERAPEUTA
}

enum CategoriaPatrocinador {
  PLATINA
  OURO
  PRATA
  BRONZE
}

enum CategoriaPlano {
  ASSOCIACAO
  SOCIO_TORCEDOR
  TURMA_REGULAR
}

enum TipoNotificacao {
  AVISO
  EVENTO
  COMUNICADO
  CONVOCACAO
}

model Premiacao {
  id          Int       @id @default(autoincrement())
  titulo      String
  descricao   String?   @db.Text
  atletaNome  String    @default("")
  atletaId    Int?
  data        DateTime? @db.Date
  imagemUrl   String?
  ativo       Boolean   @default(true)
  criadoEm    DateTime  @default(now())

  atleta      Usuario?  @relation("PremiacaoAtleta", fields: [atletaId], references: [id])
}

model Patrocinador {
  id        Int                   @id @default(autoincrement())
  nome      String
  descricao String?               @db.Text
  logoUrl   String?
  link      String?
  categoria CategoriaPatrocinador @default(OURO)
  ativo     Boolean               @default(true)
  criadoEm  DateTime              @default(now())
}

model VantagemClube {
  id          Int      @id @default(autoincrement())
  empresa     String
  beneficio   String   @db.Text
  codigoDesc  String?
  logoUrl     String?
  link        String?
  categoria   String   @default("Saúde")
  ativo       Boolean  @default(true)
  criadoEm   DateTime @default(now())
}

model Notificacao {
  id               Int               @id @default(autoincrement())
  titulo           String
  corpo            String            @db.Text
  tipo             TipoNotificacao   @default(AVISO)
  destinatarioRole String?
  destinatarioId   Int?
  destinatario     Usuario?          @relation("NotificacaoDestinatario", fields: [destinatarioId], references: [id])
  criadoEm         DateTime          @default(now())
  leituras         NotificacaoLida[]
}

model NotificacaoLida {
  id             Int         @id @default(autoincrement())
  notificacaoId  Int
  usuarioId      Int
  lidaEm         DateTime    @default(now())
  notificacao    Notificacao @relation(fields: [notificacaoId], references: [id], onDelete: Cascade)
  usuario        Usuario     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([notificacaoId, usuarioId])
}

model Evento {
  id          Int       @id @default(autoincrement())
  titulo      String
  descricao   String?   @db.Text
  data        DateTime
  local       String?
  imagemUrl   String?
  ativo       Boolean   @default(true)
  criadoEm    DateTime  @default(now())

  ingressos   Ingresso[]
}

model Ingresso {
  id        Int      @id @default(autoincrement())
  eventoId  Int
  usuarioId Int
  codigo    String   @unique @default(uuid())
  criadoEm  DateTime @default(now())

  evento    Evento   @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])

  @@unique([eventoId, usuarioId])
}

model PontoSocio {
  id        Int      @id @default(autoincrement())
  usuarioId Int
  pontos    Int      @default(0)
  motivo    String
  criadoEm  DateTime @default(now())

  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
}

model Configuracao {
  id          Int    @id @default(autoincrement())
  logradouro  String @default("")
  numero      String @default("")
  complemento String @default("")
  bairro      String @default("")
  cidade      String @default("")
  estado      String @default("")
  cep         String @default("")
  telefone    String @default("")
  whatsapp    String @default("")
  email       String @default("")
  horarios    Json   @default("{}")
  instagram   String @default("")
  facebook    String @default("")
  youtube     String @default("")
  tiktok      String @default("")

  // SMTP
  smtpHost      String  @default("")
  smtpPort      Int     @default(587)
  smtpUser      String  @default("")
  smtpSenha     String  @default("")
  smtpFromNome  String  @default("Gorila Rise")
  smtpFromEmail String  @default("")
  smtpTLS       Boolean @default(true)

  // Toggles de notificação por email
  emailBoasVindas          Boolean @default(true)
  emailUsuarioAtivado      Boolean @default(true)
  emailMatriculaAtivada    Boolean @default(true)
  emailMatriculaCancelada  Boolean @default(true)
  emailPagamentoConfirmado Boolean @default(true)
  emailPlanoVencendo       Boolean @default(true)
  emailPlanoVencido        Boolean @default(false)

  // Exibição pública
  exibirCategoriasPatrocinadores Boolean @default(false)

  // Controles de atletas — permite que o atleta exclua fotos de progresso já enviadas
  // (o envio de novas fotos é sempre permitido; só a exclusão é controlada aqui)
  permitirAlteracaoFotos Boolean @default(true)

  // Identidade do site
  nomeSite      String @default("Gorila Rise")
  descricaoSite String @default("Esporte Clube Gorila Rise - Mantenha-se forte. Academia, crossfit, natação e muito mais.")

  // Gmail OAuth2
  gmailUser         String @default("")
  gmailClientId     String @default("")
  gmailClientSecret String @default("")
  gmailRefreshToken String @default("")
}

model Funcionario {
  id        Int               @id @default(autoincrement())
  nome      String
  email     String            @unique
  cref      String            @default("")
  funcao    FuncaoFuncionario @default(PROFESSOR)
  ativo     Boolean           @default(true)
  usuarioId Int?              @unique
  criadoEm  DateTime          @default(now())

  usuario   Usuario?          @relation(fields: [usuarioId], references: [id])
}

model Ambiente {
  id         Int     @id @default(autoincrement())
  nome       String
  descricao  String?
  capacidade Int     @default(20)
  ativo      Boolean @default(true)
  turmas     Turma[]
}

model TurmaAtleta {
  turmaId  Int
  atletaId Int
  criadoEm DateTime @default(now())

  turma  Turma   @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  atleta Usuario @relation(fields: [atletaId], references: [id])

  @@id([turmaId, atletaId])
}

model TreinadorModalidade {
  treinadorId  Int
  modalidadeId Int

  treinador  Usuario    @relation("TreinadorModalidades", fields: [treinadorId], references: [id])
  modalidade Modalidade @relation(fields: [modalidadeId], references: [id])

  @@id([treinadorId, modalidadeId])
}

model Turma {
  id          Int         @id @default(autoincrement())
  codigo      String      @unique
  horario     String
  dias        Json
  tipo        String      @default("regular")
  descricao   String?
  faixaIdade  String?
  capacidade  Int         @default(6)
  status      StatusTurma @default(ATIVA)
  ambienteId  Int?
  treinadorId Int?

  ambiente  Ambiente?     @relation(fields: [ambienteId], references: [id])
  treinador Usuario?      @relation("TurmaTreinador", fields: [treinadorId], references: [id])
  checkIns  CheckIn[]
  atletas   TurmaAtleta[]
}

model CheckIn {
  id        Int      @id @default(autoincrement())
  usuarioId Int
  turmaId   Int
  data      DateTime @db.Date
  criadoEm  DateTime @default(now())

  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
  turma     Turma    @relation(fields: [turmaId], references: [id])

  @@unique([usuarioId, turmaId, data])
}

model Anamnese {
  id                    Int       @id @default(autoincrement())
  usuarioId             Int       @unique
  profissao             String?
  contatoEmergenciaNome String?
  contatoEmergenciaTel  String?
  sexo                  String?
  objetivos             Json      @default("[]")
  objetivoDescricao     String?   @db.Text
  doencas               String?   @db.Text
  medicamentos          String?   @db.Text
  cirurgias             String?   @db.Text
  problemasArticulares  String?   @db.Text
  historicoCardio       Boolean   @default(false)
  fumante               Boolean   @default(false)
  frequenciaBanheiro    String?
  atividadeAnterior     String?   @db.Text
  frequenciaSemanal     String?
  qualidadeSono         String?
  consumoAlcool         String?
  termoAssinado         Boolean   @default(false)
  termoData             DateTime?
  criadoEm              DateTime  @default(now())
  atualizadoEm          DateTime  @updatedAt

  usuario               Usuario   @relation(fields: [usuarioId], references: [id])
}

model Recorde {
  id        Int      @id @default(autoincrement())
  usuarioId Int
  exercicio String
  carga     String
  data      DateTime @default(now())

  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
}

enum TipoFoto {
  INICIAL
  PROGRESSO
}

model FotoProgresso {
  id        Int      @id @default(autoincrement())
  usuarioId Int
  tipo      TipoFoto
  url       String
  criadoEm  DateTime @default(now())

  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
}

model Biometria {
  id              Int      @id @default(autoincrement())
  usuarioId       Int      @unique
  peso            String?
  altura          String?
  pressaoArterial String?
  bioimpedancia   String?
  atualizadoEm    DateTime @updatedAt

  usuario         Usuario  @relation(fields: [usuarioId], references: [id])
}

model ProntuarioDoc {
  id        Int      @id @default(autoincrement())
  usuarioId Int
  nome      String
  url       String
  criadoEm  DateTime @default(now())

  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
}

model WOD {
  id         Int      @id @default(autoincrement())
  titulo     String
  descricao  String?
  exercicios String?  @db.Text
  data       DateTime @db.Date
  autorId    Int?
  criadoEm   DateTime @default(now())

  autor      Usuario? @relation(fields: [autorId], references: [id])
}

model TemplateTreino {
  id         Int      @id @default(autoincrement())
  titulo     String
  descricao  String?  @db.Text
  exercicios String?  @db.Text
  categoria  String?
  autorId    Int?
  criadoEm   DateTime @default(now())

  autor      Usuario? @relation("TemplatesTreino", fields: [autorId], references: [id])
}

model TreinoPrescrito {
  id         Int      @id @default(autoincrement())
  atletaNome String
  atletaId   Int?
  titulo     String
  descricao  String?  @db.Text
  exercicios String?  @db.Text
  criadoEm   DateTime @default(now())

  atleta     Usuario?     @relation(fields: [atletaId], references: [id])
  videos     TreinoVideo[]
}

model VideoTreino {
  id        Int      @id @default(autoincrement())
  titulo    String
  url       String
  descricao String?
  autorId   Int?
  criadoEm  DateTime @default(now())

  autor   Usuario?      @relation("VideosAutor", fields: [autorId], references: [id])
  treinos TreinoVideo[]
}

model TreinoVideo {
  treinoId Int
  videoId  Int

  treino TreinoPrescrito @relation(fields: [treinoId], references: [id], onDelete: Cascade)
  video  VideoTreino     @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@id([treinoId, videoId])
}

model Escalacao {
  id          Int               @id @default(autoincrement())
  titulo      String
  descricao   String?           @db.Text
  data        DateTime          @db.Date
  treinadorId Int
  criadoEm    DateTime          @default(now())

  treinador   Usuario           @relation("EscalacaoTreinador", fields: [treinadorId], references: [id])
  atletas     EscalacaoAtleta[]
}

model EscalacaoAtleta {
  escalacaoId Int
  atletaId    Int
  posicao     String?

  escalacao   Escalacao @relation(fields: [escalacaoId], references: [id], onDelete: Cascade)
  atleta      Usuario   @relation("EscalacaoAtletas", fields: [atletaId], references: [id])

  @@id([escalacaoId, atletaId])
}

model TokenRecuperacaoSenha {
  id         Int       @id @default(autoincrement())
  usuarioId  Int
  token      String    @unique
  expiresAt  DateTime
  usadoEm    DateTime?
  criadoEm   DateTime  @default(now())

  usuario    Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
}

model PrescricaoDieta {
  id                  Int      @id @default(autoincrement())
  atletaId             Int
  autorId              Int?
  peso                 Decimal  @db.Decimal(5, 2)
  altura               Decimal  @db.Decimal(5, 2)
  idade                Int
  sexo                 String
  nivelAtividade       String
  biotipo              String
  modalidadeEsportiva  String?
  objetivo             String
  restricoes           String?  @db.Text
  calorias             Int
  proteinas            Int
  carboidratos         Int
  gorduras             Int
  agua                 Int
  recomendacao         String?  @db.Text
  criadoEm             DateTime @default(now())

  atleta Usuario  @relation("PrescricaoDietaAtleta", fields: [atletaId], references: [id], onDelete: Cascade)
  autor  Usuario? @relation("PrescricaoDietaAutor", fields: [autorId], references: [id])
}
